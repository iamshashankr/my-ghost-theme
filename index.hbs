{{!< default}}

<div class="home-page">
  <div class="inner">

    {{!-- ── INTRO: big type with inline toys (icons live in partials/icons) ── --}}
    <section class="intro">
      <p class="intro-p">Hi, I’m <span class="kw"><img class="kw-face" src="{{asset 'images/avatar-nav.jpg'}}" alt="" width="48" height="48">Shashank</span>. I grew up in <span class="kw">{{> "icons/top"}}Channapatna</span>, moved to <span class="kw">{{> "icons/tree"}}Bengaluru</span> for engineering, and have been <span class="kw">writing</span> since college. I work across writing and marketing, and outside of that, I keep life slow and simple, with a small circle of friends, easy weekends, and the occasional <span class="kw">{{> "icons/car"}}road trip</span>.</p>
      <p class="intro-p">This site is where I <span class="kw">{{> "icons/pencil"}}write</span> about my experiences and things I find interesting to talk about.</p>
      <a class="intro-more" href="/about/">More about me <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></a>
    </section>

    {{!-- ── START HERE: featured posts only ── --}}
    {{#get "posts" filter="featured:true+tag:-list+tag:-bullet" limit="5" order="published_at desc"}}
      {{#if posts}}
      <section class="home-section">
        <div class="section-top"><span class="sl">Start Here</span></div>
        <ul class="post-list">
          {{#foreach posts}}
          <li class="post-row">
            <div class="pr-left">
              <a href="{{url}}" class="pr-title">{{title}}</a>
              <p class="pr-ex">{{excerpt words="48"}}</p>
            </div>
            <time class="pr-date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM YYYY"}}</time>
          </li>
          {{/foreach}}
        </ul>
      </section>
      {{/if}}
    {{/get}}

    {{!-- ── RECENT WRITING: exclude list-tagged and bullet-tagged posts ── --}}
    {{#get "posts" filter="tag:-list+tag:-bullet+featured:false" limit="6" order="published_at desc"}}
    <section class="home-section">
      <div class="section-top">
        <span class="sl">Recent Writing</span>
        <a href="/writing" class="sa">All posts →</a>
      </div>
      <ul class="post-list">
        {{#foreach posts}}
        <li class="post-row">
          <div class="pr-left">
            <a href="{{url}}" class="pr-title">{{title}}</a>
            <p class="pr-ex">{{excerpt words="48"}}</p>
          </div>
          <time class="pr-date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM YYYY"}}</time>
        </li>
        {{/foreach}}
      </ul>
    </section>
    {{/get}}

    {{!-- ── NOW: fanned card deck (edit in partials/now-deck.hbs) ── --}}
    <section class="home-section">
      <div class="section-top">
        <span class="sl">Now</span>
      </div>
      {{> "now-deck"}}
    </section>

    {{!-- ── SUBSCRIBE: same layout as Writing page ── --}}
    <section class="home-nl">
      <h3 class="writing-nl-title">Stay in the loop</h3>
      <p class="writing-nl-desc">Receive new essays sent directly to your inbox when published.</p>
      {{#unless @member}}
      <form class="sub-form" data-members-form="subscribe" novalidate>
        <div class="sub-row">
          <input class="sub-input" type="email" name="email" placeholder="your@email.com" required autocomplete="email">
          <button class="sub-btn" type="submit">
            <span class="sub-label">Subscribe</span>
            <span class="sub-loading" hidden>…</span>
          </button>
        </div>
        <p class="sub-meta">Free. Unsubscribe anytime.</p>
      </form>
      <div class="sub-success" hidden>
        <p class="sub-success-msg">✓ Check your inbox to confirm your subscription.</p>
        <p class="sub-success-sub">Can't find it? Check your spam folder.</p>
      </div>
      <div class="sub-error" hidden>
        <p class="sub-error-msg">Something went wrong, please try again.</p>
      </div>
      {{else}}
      <p class="member-note">✓ You're subscribed.</p>
      {{/unless}}
    </section>

  </div>
</div>
