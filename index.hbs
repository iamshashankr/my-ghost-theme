{{!< default}}

<div class="home-page">
  <div class="inner">

    {{!-- ── INTRO: big type with inline toys (icons live in partials/icons) ── --}}
    <section class="intro">
      <p class="intro-p">Hi, I’m <span class="kw"><img class="kw-face" src="{{asset 'images/avatar-nav.jpg'}}" alt="" width="48" height="48">Shashank</span>. I grew up in <span class="kw-pop">Channapatna<span class="pop" aria-hidden="true"><img src="{{asset 'images/icons/dolls.webp'}}" alt="" width="60" height="60" decoding="async"></span></span>, moved to <span class="kw-pop">Bengaluru<span class="pop" aria-hidden="true"><img src="{{asset 'images/icons/tree.webp'}}" alt="" width="60" height="60" decoding="async"></span></span> for engineering, and have been <span class="kw">writing</span> since college. I work across writing and marketing, and outside of that, I keep life slow and simple, with a small circle of friends, easy weekends, and the occasional <span class="kw-pop">road trip<span class="pop" aria-hidden="true"><img src="{{asset 'images/icons/car.webp'}}" alt="" width="60" height="60" decoding="async"></span></span>.</p>
      <p class="intro-p">This site is where I <span class="kw-pop">write<span class="pop" aria-hidden="true"><img src="{{asset 'images/icons/writing-hand.webp'}}" alt="" width="60" height="60" decoding="async"></span></span> about my experiences and things I find interesting to talk about.</p>
      <a class="intro-more" href="/about/">More about me <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></a>
    </section>

    {{!-- ── START HERE: featured posts as pinned notes ── --}}
    {{#get "posts" filter="featured:true+tag:-list+tag:-bullet" limit="4" order="published_at desc"}}
      {{#if posts}}
      <section class="home-section">
        <div class="section-top"><span class="sl">Start Here</span></div>
        <div class="notes">
          {{#foreach posts}}
          <a class="note" href="{{url}}">
            <span class="note-pin" aria-hidden="true"></span>
            <span class="note-title">{{title}}</span>
            <span class="note-ex">{{excerpt}}</span>
            <span class="note-meta"><time datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM YYYY"}}</time> · {{reading_time minute="1 min" minutes="% min"}}</span>
          </a>
          {{/foreach}}
        </div>
      </section>
      {{/if}}
    {{/get}}

    {{!-- ── RECENT WRITING: timeline grouped by month (grouping in initTimeline, main.js) ── --}}
    {{#get "posts" filter="tag:-list+tag:-bullet+featured:false" limit="6" order="published_at desc"}}
    <section class="home-section">
      <div class="section-top">
        <span class="sl">Recent Writing</span>
        <a href="/writing" class="sa">All posts →</a>
      </div>
      <ol class="tl" data-timeline>
        {{#foreach posts}}
        <li class="tl-item" data-month="{{date format='MMMM YYYY'}}">
          <p class="tl-month">{{date format="MMMM YYYY"}}</p>
          <a class="tl-post" href="{{url}}">
            <span class="tl-row"><span class="tl-title">{{title}}</span><span class="tl-read">{{reading_time minute="1 min" minutes="% min"}}</span></span>
            <span class="tl-ex">{{excerpt}}</span>
          </a>
        </li>
        {{/foreach}}
      </ol>
    </section>
    {{/get}}

    {{!-- ── NOW: fanned card deck (edit in partials/now-deck.hbs) ── --}}
    <section class="home-section">
      <div class="section-top">
        <span class="sl">Now</span>
      </div>
      {{> "now-deck"}}
    </section>

    {{!-- ── SUBSCRIBE: card (styles scoped to .home-nl) ── --}}
    <section class="home-nl">
      <div class="nl-head">
        <svg class="nl-env" width="32" height="24" viewBox="0 0 30 22" aria-hidden="true"><rect x="1" y="1" width="28" height="20" rx="3" fill="var(--paper)" stroke="var(--paper-line)"/><path d="M2.5 3l12.5 8.5L27.5 3" fill="none" stroke="var(--paper-line)" stroke-width="1.4"/><rect x="20.5" y="4" width="5.5" height="6.5" rx="1" fill="#C8402F"/></svg>
        <h3 class="writing-nl-title">Stay in the loop</h3>
      </div>
      <p class="writing-nl-desc">Receive new essays sent directly to your inbox when published.</p>
      {{#unless @member}}
      <form class="sub-form" data-members-form="subscribe" novalidate>
        <div class="sub-row">
          <input class="sub-input" type="email" name="email" placeholder="your@email.com" aria-label="Email address" required autocomplete="email">
          <button class="sub-btn" type="submit">
            <span class="sub-label">Subscribe</span>
            <span class="sub-loading" hidden>…</span>
          </button>
        </div>
        <p class="sub-meta">Free. Unsubscribe anytime.</p>
      </form>
      <div class="sub-success" hidden>
        <p class="sub-success-msg">✓ Check your inbox to confirm your subscription.</p>
        <p class="sub-success-sub">Can't find it? Check your spam folder.</p>
      </div>
      <div class="sub-error" hidden>
        <p class="sub-error-msg">Something went wrong, please try again.</p>
      </div>
      {{else}}
      <p class="member-note">✓ You're subscribed.</p>
      {{/unless}}
    </section>

  </div>
</div>
