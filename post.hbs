{{!< default}}

{{!-- ════════════════════════════════════════
  SINGLE ESSAY — post.hbs
  Reading bar · ← Writing · title · date, read time, copy link
  · essay · ✦ ✦ ✦ · Keep reading (3 newest, not this one) + View all · Subscribe
════════════════════════════════════════ --}}

{{#post}}
<div class="read-bar" aria-hidden="true"><i data-read-bar></i></div>

<article class="single-post essay" data-essay>

  <div class="post-wrap inner">

    <header class="post-hdr">
      <a href="/writing/" class="es-back">← Writing</a>
      <h1 class="post-title">{{title}}</h1>
      <div class="es-meta">
        <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="D MMMM YYYY"}}</time>
        <i aria-hidden="true"></i>
        <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
        <button type="button" class="copy-link-btn es-copy" data-url="{{url absolute="true"}}">
          <svg class="cl-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <svg class="cl-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="cl-label">Copy link</span><span class="cl-done">Link copied</span>
        </button>
      </div>
    </header>

    {{#if feature_image}}
    <figure class="post-img">
      <img
        srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width:680px) calc(100vw - 40px), 568px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        loading="eager" fetchpriority="high" decoding="async">
      {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="gh-content post-body">
      {{content}}
    </div>
    <script>
    /* Ghost sizes essay images for a 720px column; ours is narrower, so let the browser pick the
       smallest copy that is still sharp on this screen. Runs before the lazy images start loading. */
    (function(){
      var imgs = document.querySelectorAll('.post-body .kg-image-card:not(.kg-width-wide):not(.kg-width-full) img[srcset]');
      for (var i = 0; i < imgs.length; i++) {
        imgs[i].sizes = '(max-width: 600px) calc(100vw - 36px), 536px';
        imgs[i].decoding = 'async';
      }
    })();
    </script>

    <p class="es-end" aria-hidden="true">✦ ✦ ✦</p>

    {{#get "posts" filter="id:-{{id}}+tag:-list+tag:-bullet" limit="3" order="published_at desc" as |more pages|}}
    {{#if more}}
    <section class="es-more" aria-label="Keep reading">
      <p class="es-more-label">Keep reading</p>
      <div class="es-more-grid">
        {{#foreach more}}
        <a class="wf-card" href="{{url}}">
          <time class="wf-card-date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="MMM YYYY"}}</time>
          <span class="wf-card-title">{{title}}</span>
          <span class="wf-card-ex">{{excerpt words="30"}}</span>
        </a>
        {{/foreach}}
        <a class="es-all" href="/writing/">
          {{#get "posts" filter="tag:-list+tag:-bullet" limit="1" as |x p|}}<span class="es-all-n">{{p.total}} essays</span>{{/get}}
          <span class="es-all-go">View all writing <b aria-hidden="true">→</b></span>
        </a>
      </div>
    </section>
    {{/if}}
    {{/get}}

    <div class="es-rule" aria-hidden="true"></div>
    {{> "subscribe-box"}}

  </div>

</article>
{{/post}}
