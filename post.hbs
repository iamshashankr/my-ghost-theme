{{!< default}}

{{!-- ════════════════════════════════════════
  SINGLE POST — post.hbs
  {{#post}} wrapper explicitly sets context,
  fixing the "undefined" content rendering bug.
════════════════════════════════════════ --}}

{{#post}}
<article class="single-post">

  <div class="post-wrap inner">

    <header class="post-hdr">
      {{#primary_tag}}<a href="{{url}}" class="post-cat">{{name}}</a>{{/primary_tag}}
      <h1 class="post-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="post-sub">{{custom_excerpt}}</p>{{/if}}
      <div class="post-byline">
        <time class="post-date" datetime="{{date format='YYYY-MM-DD'}}">{{date format="Do MMMM YYYY"}}</time>
        <button type="button" class="copy-link-btn" aria-label="Copy link to this post" data-url="{{url absolute="true"}}">
          <svg class="cl-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <svg class="cl-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><path d="M20 6 9 17l-5-5"/></svg>
        </button>
      </div>
    </header>

    {{#if feature_image}}
    <figure class="post-img">
      <img
        srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w"
        sizes="(max-width:680px) calc(100vw - 40px), 568px"
        src="{{img_url feature_image size="m"}}"
        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
        loading="eager">
      {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="gh-content post-body">
      {{content}}
    </div>

    <footer class="post-foot">
      <a href="/writing" class="back-link">← Back to Writing</a>
      {{#if tags}}
      <div class="post-tags">
        {{#foreach tags}}<a href="{{url}}" class="tag-chip">{{name}}</a>{{/foreach}}
      </div>
      {{/if}}
    </footer>

  </div>

</article>

{{#if prev_post}}{{#if next_post}}
<nav class="post-nav inner">
  {{#if prev_post}}
  <a class="pag-item" href="{{prev_post.url}}">
    <span class="pag-dir">← Previous</span>
    <span class="pag-name">{{prev_post.title}}</span>
  </a>
  {{/if}}
  {{#if next_post}}
  <a class="pag-item pag-r" href="{{next_post.url}}">
    <span class="pag-dir">Next →</span>
    <span class="pag-name">{{next_post.title}}</span>
  </a>
  {{/if}}
</nav>
{{/if}}{{/if}}

{{/post}}
