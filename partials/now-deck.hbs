--}}
<div class="nd" data-now-deck>
  <div class="nd-stage" tabindex="0" role="group" aria-roledescription="carousel" aria-label="What I'm into right now. Use the arrow keys to browse.">

    <a class="nd-card" href="https://www.goodreads.com/book/show/6900.Tuesdays_with_Morrie" draggable="false" aria-label="Reading: Tuesdays with Morrie">
      <img src="{{asset 'images/now-reading.jpg'}}" alt="" width="600" height="900" loading="lazy" decoding="async" draggable="false">
      <span class="nd-gloss" aria-hidden="true"></span>
    </a>

    <a class="nd-card" href="https://www.imdb.com/title/tt10986410/" draggable="false" aria-label="Watching: Ted Lasso">
      <img src="{{asset 'images/now-watching.jpg'}}" alt="" width="600" height="900" loading="lazy" decoding="async" draggable="false">
      <span class="nd-gloss" aria-hidden="true"></span>
    </a>

    <a class="nd-card" href="https://www.growedin.com/" draggable="false" aria-label="Cookin’ at: GrowedIn">
